# ---------------------------------------------------------------------------
# PAS — environment template
#
# Copy to .env in the PROJECT ROOT (next to manage.py) and fill in real
# values. settings.py:18 reads BASE_DIR / ".env" — nowhere else.
#
#     cp .env.example .env
#
# Never commit the real .env: it holds live Paystack and Cloudinary keys.
# NOTE: this file must NOT contain DJANGO_ORIGIN — that is a Vite variable
# and belongs in frontend/.env.
# ---------------------------------------------------------------------------

# Django core. Generate a key with:
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# Changing it invalidates all sessions and pending password-reset links.
DJANGO_SECRET_KEY=
DEBUG=True

# Cloudinary — media storage (console.cloudinary.com > Dashboard)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack — dashboard.paystack.com > Settings > API Keys & Webhooks.
# Use sk_test_/pk_test_ keys in development.
# The two URLs below are Paystack's standard endpoints; leave as-is.
PAYSTACK_LIVE_SECRET_KEY=
PAYSTACK_LIVE_PUBLIC_KEY=
PAYSTACK_INITIALIZE_PAYMENT_URL=https://api.paystack.co/transaction/initialize
PAYSTACK_VERIFY_URL=https://api.paystack.co/transaction/verify/

# Email — used for signup OTP codes and password resets.
# With DEBUG=True Django uses the console backend and prints emails to the
# terminal, so this can stay blank in development.
EMAIL_HOST_PASSWORD=

# Database. Currently unused: settings.py runs SQLite and the MySQL block
# that reads these is commented out. Kept for the eventual move off SQLite.
EMAIL_HOST_USER=noreply@pas.com.ng
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=
