            return Response({'status': 'unbookmarked', 'admin_bypass': True}, status=200)
    
    bookmark, created = InterviewBookmark.objects.get_or_create(
        user=request.user,
        interview=interview
    )
    
    if created:
        return Response({'status': 'bookmarked'}, status=201)
    else:
