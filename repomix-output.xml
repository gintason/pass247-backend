      {recommendedQuizzes.length > 0 && (
        <div style={{ marginTop: '3rem' }}>
          <h3 style={{ fontSize: '1.5rem', fontWeight: 700, marginBottom: '1.5rem', display: 'flex', alignItems: 'center', gap: '0.75rem' }}>
            <span style={{ color: '#f59e0b' }}>⭐</span>
            Recommended Quizzes
          </h3>

          <div style={{
            display: 'grid',
