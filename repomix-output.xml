                          <i className={`bi bi-${p} text-${p === 'twitter' ? 'info' : p === 'whatsapp' ? 'success' : 'primary'}`}></i>
                          {p.charAt(0).toUpperCase() + p.slice(1)}
                        </button>
                      ))}
                    </div>
                  </div>
