                {/* Quick Reasons */}
                {!showSupport && (
                  <motion.div 
                    className="mb-4"
                    initial={{ opacity: 0 }}
                    animate={{ opacity: 1 }}
                    transition={{ delay: 0.6 }}
                  >
                    <p className="text-muted mb-2">Quick help:</p>
                    <div className="d-flex flex-wrap gap-2 justify-content-center">
                      {reasons.slice(0, 3).map((reason, index) => (
                        <button
                          key={index}
