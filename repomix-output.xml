<file path="frontend/src/contexts/AuthContext.jsx">
import React, { createContext, useState, useContext, useEffect } from 'react';
import api from '../api/client';

const AuthContext = createContext();

export const useAuth = () => {
  return useContext(AuthContext);
};

export const AuthProvider = ({ children }) => {
  const [user, setUser] = useState(null);
  const [loading, setLoading] = useState(true);
  const [isAuthenticated, setIsAuthenticated] = useState(false);

  useEffect(() => {
    checkAuthStatus();
  }, []);

  const checkAuthStatus = async () => {
    try {
      // CHANGE: /api/users/auth/status/ -> /api/auth/status/
      const response = await api.get('/api/auth/status/');
      if (response.data.is_authenticated) {
        setUser({
          ...response.data.user,
          isAdmin: response.data.user?.is_staff || response.data.user?.is_superuser
        });
        setIsAuthenticated(true);
      }
    } catch (error) {
      console.error('Auth check failed:', error);
    } finally {
      setLoading(false);
    }
  };

  const login = async (username, password) => {
    try {
      // CHANGE: /api/users/login/ -> /api/auth/login/
      const response = await api.post('/api/auth/login/', {
        username,
        password
      });
      
      if (response.data.success) {
        setUser({
          ...response.data.user,
          isAdmin: response.data.user?.is_staff || response.data.user?.is_superuser
        });
        setIsAuthenticated(true);
        return { success: true };
      }
      return { success: false, error: 'Login failed' };
    } catch (error) {
      const data = error.response?.data || {};
      return {
        success: false,
        // The API returns 403 + requires_verification when the password is
        // correct but the email has not been confirmed yet.
        requiresVerification: Boolean(data.requires_verification),
        email: data.email,
        username: data.username,
        error: data.message || 'Login failed'
      };
    }
  };

  const logout = async () => {
    try {
      await api.post('/api/auth/logout/');
    } catch (error) {
      // Clear local state regardless. If the request failed because the
      // session was already gone, staying "logged in" in the UI is worse
      // than the error itself.
      console.error('Logout request failed; clearing session locally:', error);
    } finally {
      setUser(null);
      setIsAuthenticated(false);
    }
  };

  const register = async (userData) => {
    try {
      const response = await api.post('/api/auth/register/', userData);
      return {
        success: true,
        data: response.data,
        requiresVerification: Boolean(response.data?.requires_verification),
        email: response.data?.email,
      };
    } catch (error) {
      const data = error.response?.data || {};
      return {
        success: false,
        errors: data.errors,
        error: data.message || 'Registration failed'
      };
    }
  };

  // Verify the signup code. On success the API activates the account and
  // establishes the session, so we adopt the returned user directly.
  const verifyEmail = async (email, code) => {
    try {
      const response = await api.post('/api/auth/verify-otp/', { email, code });
      if (response.data.success) {
        setUser({
          ...response.data.user,
          isAdmin: response.data.user?.is_staff || response.data.user?.is_superuser
        });
        setIsAuthenticated(true);
        return { success: true };
      }
      return { success: false, error: response.data.message || 'Verification failed' };
    } catch (error) {
      return {
        success: false,
        error: error.response?.data?.message || 'Verification failed'
      };
    }
  };

  const resendVerification = async (email) => {
    try {
      const response = await api.post('/api/auth/resend-otp/', { email });
      return { success: true, message: response.data?.message };
    } catch (error) {
      return {
        success: false,
        error: error.response?.data?.message || 'Could not send a new code'
      };
    }
  };

  const updateUser = (userData) => {
    setUser(prev => ({ ...prev, ...userData }));
  };

  const value = {
    user,
    loading,
    isAuthenticated,
    login,
    logout,
    register,
    verifyEmail,
    resendVerification,
    updateUser
  };

  return (
    <AuthContext.Provider value={value}>
      {children}
    </AuthContext.Provider>
  );
};
</file>

<file path="frontend/src/Styles/auth.css">
/* ==========================================================================
   Pass24/7 — Auth screens (sign in, sign up, verify, reset) and Dashboard
   Built on the design tokens. These components carry no inline <style>
   blocks, so ordinary specificity applies and nothing needs !important.
   ========================================================================== */

/* ---- Shell --------------------------------------------------------------
   A split layout: brand panel on the left, form on the right. The brand
   panel collapses away below lg so the form gets the full width on mobile
   rather than being squeezed under a decorative block. */

.auth-shell {
  min-block-size: 100svh;
  display: grid;
  grid-template-columns: 1fr;
  background: var(--pas-mist);
}

@media (min-width: 992px) {
  .auth-shell { grid-template-columns: 1.05fr 1fr; }
}

/* Plain variant — white throughout, no brand panel, form centred on the
   page. Used by Register; Login and VerifyEmail keep the split layout. */
.auth-shell--plain {
  grid-template-columns: 1fr;
  background: var(--pas-white);
}

.auth-shell--plain .auth-main {
  background: var(--pas-white);
  padding-block: clamp(2rem, 5vw, 4rem);
}

@media (min-width: 992px) {
  /* Override the split layout inherited from .auth-shell */
  .auth-shell--plain { grid-template-columns: 1fr; }
}

/* Brand side */
.auth-aside {
  display: none;
  position: relative;
  padding: var(--pas-space-8) var(--pas-space-7);
  background: var(--pas-ink);
  color: rgba(255, 255, 255, 0.82);
  overflow: hidden;
  isolation: isolate;
}

@media (min-width: 992px) {
  .auth-aside { display: flex; flex-direction: column; justify-content: space-between; }
}

.auth-aside::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: -1;
  background:
    radial-gradient(58% 70% at 22% 18%, rgba(68, 0, 255, 0.55) 0%, transparent 62%),
    radial-gradient(46% 58% at 86% 84%, rgba(255, 193, 0, 0.18) 0%, transparent 60%);
}

.auth-aside-brand {
  display: inline-flex;
  align-items: center;
  gap: var(--pas-space-3);
  font-family: var(--pas-font-display);
  font-weight: 800;
  font-size: 1.15rem;
  color: var(--pas-white);
  text-decoration: none;
}

.auth-aside-title {
  font-family: var(--pas-font-display);
  font-size: clamp(1.9rem, 1.2rem + 1.6vw, 2.6rem);
  font-weight: 800;
  line-height: 1.08;
  letter-spacing: var(--pas-tracking-tight);
  color: var(--pas-white);
  text-wrap: balance;
  max-inline-size: 16ch;
  margin-bottom: var(--pas-space-4);
}

.auth-aside-copy {
  font-size: var(--pas-text-lg);
  line-height: var(--pas-leading-normal);
  max-inline-size: 42ch;
  margin-bottom: 0;
}

/* Signature: the answer-sheet option marker, used as a proof-point list.
   The content genuinely is multiple choice, so the marker carries meaning
   rather than decorating. */
.auth-points { list-style: none; margin: var(--pas-space-6) 0 0; padding: 0; }

.auth-points li {
  display: flex;
  align-items: flex-start;
  gap: var(--pas-space-3);
  margin-bottom: var(--pas-space-4);
  color: rgba(255, 255, 255, 0.82);
}

.auth-points li::before {
  content: counter(auth-point, upper-alpha);
  counter-increment: auth-point;
  display: grid;
  place-items: center;
  inline-size: 1.9rem;
  block-size: 1.9rem;
  flex: none;
  border-radius: 50%;
  border: 1.5px solid rgba(255, 255, 255, 0.28);
  background: rgba(255, 255, 255, 0.06);
  font-family: var(--pas-font-data);
  font-size: 0.82rem;
  color: var(--pas-gold);
}

.auth-points { counter-reset: auth-point; }

/* ---- Form side ---------------------------------------------------------- */

.auth-main {
  display: grid;
  place-items: center;
  padding: var(--pas-space-6) clamp(1rem, 5vw, 3rem);
  background: var(--pas-surface);
}

.auth-card {
  inline-size: 100%;
  max-inline-size: 440px;
}

.auth-card--wide { max-inline-size: 560px; }

.auth-eyebrow {
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: var(--pas-tracking-wide);
  color: var(--pas-indigo-deep);
  margin-bottom: var(--pas-space-2);
}

.auth-title {
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-2xl);
  font-weight: 700;
  letter-spacing: var(--pas-tracking-tight);
  color: var(--pas-ink);
  margin-bottom: var(--pas-space-2);
}

.auth-subtitle {
  color: var(--pas-slate);
  margin-bottom: var(--pas-space-6);
}

.auth-form .form-label { margin-bottom: var(--pas-space-2); }
.auth-form .form-control { margin-bottom: var(--pas-space-1); }
.auth-form .mb-3 { margin-bottom: var(--pas-space-4) !important; }

.auth-submit {
  inline-size: 100%;
  margin-top: var(--pas-space-2);
}

.auth-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--pas-space-3);
  flex-wrap: wrap;
  margin-bottom: var(--pas-space-4);
  font-size: var(--pas-text-sm);
}

.auth-alt {
  margin-top: var(--pas-space-5);
  padding-top: var(--pas-space-5);
  border-top: 1px solid var(--pas-line);
  text-align: center;
  color: var(--pas-slate);
  font-size: var(--pas-text-sm);
}

.auth-alt a { font-weight: 600; }

/* Password strength hint */
.auth-hint {
  display: block;
  font-size: var(--pas-text-sm);
  color: var(--pas-muted);
  margin-top: var(--pas-space-1);
}

/* ---- OTP entry ----------------------------------------------------------
   Mono with wide tracking so the six digits read as discrete characters,
   and tabular figures so the field doesn't reflow as digits are typed. */

.otp-input {
  inline-size: 100%;
  text-align: center;
  font-family: var(--pas-font-data);
  font-variant-numeric: tabular-nums;
  font-size: clamp(1.6rem, 1.2rem + 1.6vw, 2.2rem);
  font-weight: 500;
  letter-spacing: 0.5em;
  text-indent: 0.5em;  /* re-centres text that letter-spacing pushes left */
  padding: var(--pas-space-4) var(--pas-space-3);
  border: 1px solid var(--pas-line);
  border-radius: var(--pas-radius);
  background: var(--pas-mist);
  color: var(--pas-ink);
}

.otp-input:focus {
  outline: none;
  border-color: var(--pas-indigo);
  box-shadow: var(--pas-shadow-focus);
  background: var(--pas-surface);
}

.otp-input::placeholder { color: var(--pas-line); letter-spacing: 0.5em; }

.otp-sent-to {
  display: inline-block;
  font-family: var(--pas-font-data);
  font-size: var(--pas-text-sm);
  color: var(--pas-ink);
  background: var(--pas-mist);
  border: 1px solid var(--pas-line);
  border-radius: var(--pas-radius-pill);
  padding: 0.25rem 0.75rem;
}

.otp-resend {
  background: none;
  border: 0;
  padding: 0;
  font-family: var(--pas-font-display);
  font-weight: 600;
  font-size: var(--pas-text-sm);
  color: var(--pas-indigo);
  cursor: pointer;
}
.otp-resend:disabled { color: var(--pas-muted); cursor: default; }

/* ==========================================================================
   Dashboard
   ========================================================================== */

.dash {
  background: var(--pas-mist);
  min-block-size: 100svh;
  padding-block: var(--pas-space-6) var(--pas-space-8);
}

.dash-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--pas-space-4);
  flex-wrap: wrap;
  margin-bottom: var(--pas-space-6);
}

.dash-greeting {
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-2xl);
  font-weight: 700;
  letter-spacing: var(--pas-tracking-tight);
  color: var(--pas-ink);
  margin-bottom: var(--pas-space-1);
}

.dash-sub { color: var(--pas-slate); margin-bottom: 0; }

/* Stat tiles — the number is the content, so it leads and uses the data face */
.dash-stat {
  block-size: 100%;
  padding: var(--pas-space-5);
  background: var(--pas-surface);
  border: 1px solid var(--pas-line);
  border-radius: var(--pas-radius-lg);
  box-shadow: var(--pas-shadow-sm);
  transition: box-shadow var(--pas-duration) var(--pas-ease),
              transform var(--pas-duration) var(--pas-ease);
}
.dash-stat:hover { box-shadow: var(--pas-shadow-md); transform: translateY(-2px); }

.dash-stat-label {
  display: block;
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: var(--pas-tracking-wide);
  color: var(--pas-muted);
  margin-bottom: var(--pas-space-2);
}

.dash-stat-value {
  font-family: var(--pas-font-data);
  font-variant-numeric: tabular-nums;
  font-size: clamp(1.7rem, 1.3rem + 1.2vw, 2.3rem);
  font-weight: 500;
  line-height: 1;
  color: var(--pas-ink);
}

.dash-stat-unit { font-size: 0.5em; color: var(--pas-muted); margin-left: 0.15em; }

.dash-stat-icon {
  display: grid;
  place-items: center;
  inline-size: 42px;
  block-size: 42px;
  border-radius: var(--pas-radius-sm);
  background: color-mix(in srgb, var(--pas-indigo) 9%, transparent);
  color: var(--pas-indigo);
  font-size: 1.15rem;
  margin-bottom: var(--pas-space-4);
}

.dash-panel {
  background: var(--pas-surface);
  border: 1px solid var(--pas-line);
  border-radius: var(--pas-radius-lg);
  box-shadow: var(--pas-shadow-sm);
  padding: var(--pas-space-5);
  block-size: 100%;
}

.dash-panel-title {
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-lg);
  font-weight: 700;
  color: var(--pas-ink);
  margin-bottom: var(--pas-space-4);
}

/* Empty states are an invitation to act, not a shrug */
.dash-empty { text-align: center; padding: var(--pas-space-7) var(--pas-space-4); }
.dash-empty i { font-size: 2rem; color: var(--pas-line); display: block; margin-bottom: var(--pas-space-3); }
.dash-empty p { color: var(--pas-slate); margin-bottom: var(--pas-space-4); }

@media (prefers-reduced-motion: reduce) {
  .dash-stat:hover { transform: none; }
}

/* Dashboard header actions — wrap on narrow screens rather than overflow */
.dash-header-actions {
  display: flex;
  align-items: center;
  gap: var(--pas-space-2);
  flex-wrap: wrap;
}
</file>

<file path="frontend/src/Styles/Home.css">
/* ==========================================================================
   Pass24/7 — Home

   Rewritten. The previous file was 862 lines with 496 `!important`
   declarations, and was never imported anywhere — so none of Home.jsx's
   semantic classes had any styling at all.

   This targets the same class names Home.jsx already uses, so the page
   restyles with no JSX changes and no functional risk.
   ========================================================================== */

/* ---- Preloader --------------------------------------------------------- */

.home-preloader {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: grid;
  place-items: center;
  background: var(--pas-white);
}

.home-preloader .spinner {
  inline-size: 44px;
  block-size: 44px;
  border-radius: 50%;
  border: 3px solid color-mix(in srgb, var(--pas-indigo) 15%, transparent);
  border-top-color: var(--pas-indigo);
  border-right-color: var(--pas-gold);
  animation: pas-spin 800ms linear infinite;
}

@keyframes pas-spin { to { transform: rotate(360deg); } }

/* ---- Hero ---------------------------------------------------------------
   The risk taken here: a committed deep-indigo surface rather than the safe
   white-page-with-indigo-accents. The brand already uses this colour at full
   saturation throughout; half-committing to it is what reads as templated. */

.home-hero-carousel {
  position: relative;
  background: var(--pas-ink);
  overflow: hidden;
}

/* Ambient brand wash — two soft light sources, avoids gradient banding */
.home-hero-carousel::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background:
    radial-gradient(60% 80% at 18% 22%, rgba(68, 0, 255, 0.55) 0%, transparent 62%),
    radial-gradient(50% 70% at 88% 78%, rgba(255, 193, 0, 0.22) 0%, transparent 60%);
}

/* Legibility scrim over carousel imagery */
.home-hero-carousel::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 2;
  pointer-events: none;
  background: linear-gradient(180deg,
    rgba(18, 16, 26, 0.35) 0%,
    rgba(18, 16, 26, 0.62) 55%,
    rgba(18, 16, 26, 0.88) 100%);
}

.home-hero-carousel .carousel-item img,
.home-hero-carousel img {
  object-fit: cover;
  min-block-size: clamp(460px, 62vh, 680px);
  filter: saturate(0.7) contrast(1.05);
}

.home-hero-carousel .carousel-caption {
  z-index: 3;
  inset-inline: 0;
  inset-block-end: 0;
  display: grid;
  place-content: center;
  block-size: 100%;
  padding: var(--pas-space-6) clamp(1rem, 5vw, 4rem);
  text-align: left;
  max-inline-size: min(100%, var(--pas-container));
  margin-inline: auto;
}

.hero-title {
  font-family: var(--pas-font-display);
  font-size: clamp(2.1rem, 1.2rem + 4.2vw, 4.25rem);
  font-weight: 800;
  line-height: 1.04;
  letter-spacing: -0.03em;
  color: var(--pas-white);
  text-wrap: balance;
  max-inline-size: 18ch;
  margin-bottom: var(--pas-space-4);
}

.hero-title em,
.hero-title .accent { font-style: normal; color: var(--pas-gold); }

.hero-subtitle {
  font-size: clamp(1rem, 0.9rem + 0.5vw, 1.25rem);
  line-height: var(--pas-leading-normal);
  color: rgba(255, 255, 255, 0.82);
  max-inline-size: 52ch;
  margin-bottom: var(--pas-space-6);
}

.hero-cta {
  display: flex;
  flex-wrap: wrap;
  gap: var(--pas-space-3);
  align-items: center;
}

.hero-cta .btn { box-shadow: 0 10px 30px rgba(0, 0, 0, 0.28); }

.home-hero-carousel .carousel-indicators { z-index: 4; margin-bottom: var(--pas-space-4); }
.home-hero-carousel .carousel-indicators [data-bs-target] {
  inline-size: 28px;
  block-size: 3px;
  border: 0;
  border-radius: var(--pas-radius-pill);
  background: rgba(255, 255, 255, 0.35);
  opacity: 1;
  transition: background var(--pas-duration) var(--pas-ease);
}
.home-hero-carousel .carousel-indicators .active { background: var(--pas-gold); }

.home-hero-carousel .carousel-control-prev,
.home-hero-carousel .carousel-control-next { z-index: 4; inline-size: 8%; opacity: 0.5; }
.home-hero-carousel .carousel-control-prev:hover,
.home-hero-carousel .carousel-control-next:hover { opacity: 1; }

/* ---- Section headers ---------------------------------------------------- */

.home-section-header {
  max-inline-size: 62ch;
  margin-inline: auto;
  margin-block-end: var(--pas-space-7);
  text-align: center;
}

/* Signature: the answer-sheet option marker, drawn from the product's own
   world — every question in this app is multiple choice. */
.home-section-header::before {
  content: '';
  display: block;
  inline-size: 2rem;
  block-size: 2rem;
  margin: 0 auto var(--pas-space-4);
  border-radius: 50%;
  border: 1.5px solid color-mix(in srgb, var(--pas-indigo) 30%, transparent);
  background: radial-gradient(circle at center, var(--pas-indigo) 0 34%, transparent 35%);
}

.home-section-title,
.home-section-title2 {
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-3xl);
  font-weight: 700;
  line-height: 1.1;
  letter-spacing: var(--pas-tracking-tight);
  color: var(--pas-ink);
  text-wrap: balance;
  margin-bottom: var(--pas-space-3);
}

.home-section-subtitle {
  font-size: var(--pas-text-lg);
  line-height: var(--pas-leading-normal);
  color: var(--pas-slate);
  margin-bottom: 0;
}

/* ---- Section shells ----------------------------------------------------- */

.home-services-section,
.home-categories-section,
.home-how-it-works,
.home-blog-section,
.home-search-section { padding-block: var(--pas-section-y); }

.home-services-section { background: var(--pas-white); }
.home-categories-section { background: var(--pas-mist); }
.home-how-it-works { background: var(--pas-white); }
.home-blog-section { background: var(--pas-mist); }

/* ---- Service cards ------------------------------------------------------ */

.home-service-card {
  position: relative;
  block-size: 100%;
  display: flex;
  flex-direction: column;
  padding: var(--pas-space-6);
  background: var(--pas-white);
  border: 1px solid var(--pas-line);
  border-radius: var(--pas-radius-lg);
  box-shadow: var(--pas-shadow-sm);
  overflow: hidden;
  transition:
    transform var(--pas-duration) var(--pas-ease),
    box-shadow var(--pas-duration) var(--pas-ease),
    border-color var(--pas-duration) var(--pas-ease);
}

.home-service-card::before {
  content: '';
  position: absolute;
  inset-block-start: 0;
  inset-inline: 0;
  block-size: 3px;
  background: linear-gradient(90deg, var(--pas-indigo), var(--pas-gold));
  transform: scaleX(0);
  transform-origin: left;
  transition: transform var(--pas-duration-slow) var(--pas-ease);
}

.home-service-card:hover {
  transform: translateY(-6px);
  box-shadow: var(--pas-shadow-lg);
  border-color: color-mix(in srgb, var(--pas-indigo) 22%, var(--pas-line));
}
.home-service-card:hover::before { transform: scaleX(1); }

.service-icon-wrapper {
  display: grid;
  place-items: center;
  inline-size: 56px;
  block-size: 56px;
  border-radius: var(--pas-radius);
  background: color-mix(in srgb, var(--pas-indigo) 9%, transparent);
  color: var(--pas-indigo);
  margin-bottom: var(--pas-space-4);
  transition: background var(--pas-duration) var(--pas-ease),
              color var(--pas-duration) var(--pas-ease);
}
.home-service-card:hover .service-icon-wrapper {
  background: var(--pas-indigo);
  color: var(--pas-white);
}

.service-icon { font-size: 1.5rem; line-height: 1; }

.service-title {
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-xl);
  font-weight: 700;
  color: var(--pas-ink);
  letter-spacing: var(--pas-tracking-tight);
  margin-bottom: var(--pas-space-2);
}

.service-subtitle {
  font-size: var(--pas-text-base);
  line-height: var(--pas-leading-normal);
  color: var(--pas-slate);
  margin-bottom: var(--pas-space-4);
}

.service-badges {
  display: flex;
  flex-wrap: wrap;
  gap: var(--pas-space-2);
  margin-bottom: var(--pas-space-5);
}

.service-badge {
  display: inline-flex;
  align-items: center;
  gap: 0.35em;
  padding: 0.35rem 0.7rem;
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-xs);
  font-weight: 600;
  color: var(--pas-slate);
  background: var(--pas-mist);
  border: 1px solid var(--pas-line);
  border-radius: var(--pas-radius-pill);
  white-space: nowrap;
}

.service-cta-btn {
  margin-block-start: auto;
  align-self: flex-start;
  display: inline-flex;
  align-items: center;
  gap: 0.45em;
  font-family: var(--pas-font-display);
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--pas-indigo);
  text-decoration: none;
  padding: 0.4rem 0;
}
.service-cta-btn .bi { transition: transform var(--pas-duration) var(--pas-ease); }
.home-service-card:hover .service-cta-btn .bi,
.service-cta-btn:hover .bi { transform: translateX(4px); }

/* ---- Category cards ----------------------------------------------------- */

.home-category-card {
  position: relative;
  display: block;
  block-size: 100%;
  border-radius: var(--pas-radius-lg);
  overflow: hidden;
  background: var(--pas-white);
  border: 1px solid var(--pas-line);
  box-shadow: var(--pas-shadow-sm);
  text-decoration: none;
  transition: transform var(--pas-duration) var(--pas-ease),
              box-shadow var(--pas-duration) var(--pas-ease);
}
.home-category-card:hover { transform: translateY(-5px); box-shadow: var(--pas-shadow-lg); }

.card-img-wrapper {
  position: relative;
  aspect-ratio: 16 / 10;
  overflow: hidden;
  background: var(--pas-mist);
}
.card-img-wrapper img {
  inline-size: 100%;
  block-size: 100%;
  object-fit: cover;
  transition: transform var(--pas-duration-slow) var(--pas-ease);
}
.home-category-card:hover .card-img-wrapper img { transform: scale(1.05); }

.category-badge {
  position: absolute;
  inset-block-start: var(--pas-space-3);
  inset-inline-start: var(--pas-space-3);
  z-index: 2;
  padding: 0.3rem 0.7rem;
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-xs);
  font-weight: 700;
  color: var(--pas-ink);
  background: var(--pas-gold);
  border-radius: var(--pas-radius-pill);
  box-shadow: var(--pas-shadow-sm);
}

/* ---- How it works — a real sequence, so numbering carries information --- */

.home-how-it-works .row { counter-reset: pas-step; }

.home-step-card {
  position: relative;
  block-size: 100%;
  padding: var(--pas-space-6);
  background: var(--pas-white);
  border: 1px solid var(--pas-line);
  border-radius: var(--pas-radius-lg);
  counter-increment: pas-step;
}

.home-step-card::before {
  content: counter(pas-step, decimal-leading-zero);
  display: grid;
  place-items: center;
  inline-size: 2.5rem;
  block-size: 2.5rem;
  margin-bottom: var(--pas-space-4);
  border-radius: 50%;
  background: var(--pas-indigo);
  color: var(--pas-white);
  font-family: var(--pas-font-data);
  font-size: 0.9rem;
  font-weight: 500;
}

/* ---- Search panel -------------------------------------------------------
   The search section deliberately has NO background of its own: it overlaps
   the hero's lower edge as a floating card. Its detailed styling lives in
   Home.jsx's inline <style> block, which uses !important throughout and
   therefore wins over this file. Kept here only as a fallback. */

.home-search-section { background: transparent; }

@media (max-width: 575.98px) {
  .home-search-card { flex-direction: column; border-radius: var(--pas-radius-lg); }
  .home-search-button { inline-size: 100%; }
}

/* ---- Blog cards --------------------------------------------------------- */

.home-blog-card {
  block-size: 100%;
  display: flex;
  flex-direction: column;
  background: var(--pas-white);
  border: 1px solid var(--pas-line);
  border-radius: var(--pas-radius-lg);
  overflow: hidden;
  box-shadow: var(--pas-shadow-sm);
  transition: transform var(--pas-duration) var(--pas-ease),
              box-shadow var(--pas-duration) var(--pas-ease);
}
.home-blog-card:hover { transform: translateY(-4px); box-shadow: var(--pas-shadow-md); }
.home-blog-card .card-body { padding: var(--pas-space-5); }

/* ---- Closing CTA -------------------------------------------------------- */

.home-cta-section {
  position: relative;
  padding-block: var(--pas-section-y);
  background: var(--pas-ink);
  color: rgba(255, 255, 255, 0.8);
  overflow: hidden;
  text-align: center;
}

.home-cta-section::before {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(55% 75% at 50% 0%, rgba(68, 0, 255, 0.45) 0%, transparent 65%),
    radial-gradient(40% 60% at 85% 100%, rgba(255, 193, 0, 0.16) 0%, transparent 60%);
}

.home-cta-section > * { position: relative; z-index: 1; }

.home-cta-title {
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-3xl);
  font-weight: 800;
  letter-spacing: var(--pas-tracking-tight);
  color: var(--pas-white);
  text-wrap: balance;
  max-inline-size: 20ch;
  margin-inline: auto;
  margin-bottom: var(--pas-space-3);
}

.home-cta-subtitle {
  font-size: var(--pas-text-lg);
  color: rgba(255, 255, 255, 0.75);
  max-inline-size: 54ch;
  margin-inline: auto;
  margin-bottom: var(--pas-space-6);
}

.home-cta-button {
  display: inline-flex;
  align-items: center;
  gap: 0.5em;
  padding: 0.95rem 2.2rem;
  border: 0;
  border-radius: var(--pas-radius-pill);
  background: var(--pas-gold);
  color: var(--pas-ink);
  font-family: var(--pas-font-display);
  font-weight: 700;
  font-size: 1.05rem;
  text-decoration: none;
  box-shadow: 0 10px 30px rgba(255, 193, 0, 0.3);
  transition: transform var(--pas-duration-fast) var(--pas-ease),
              box-shadow var(--pas-duration) var(--pas-ease);
}
.home-cta-button:hover {
  color: var(--pas-ink);
  transform: translateY(-2px);
  box-shadow: 0 16px 40px rgba(255, 193, 0, 0.4);
}

/* ---- View-all link ------------------------------------------------------ */

.home-view-all-btn {
  display: inline-flex;
  align-items: center;
  gap: 0.45em;
  padding: 0.6rem 1.4rem;
  border: 1px solid color-mix(in srgb, var(--pas-indigo) 35%, transparent);
  border-radius: var(--pas-radius-pill);
  font-family: var(--pas-font-display);
  font-weight: 600;
  font-size: 0.95rem;
  color: var(--pas-indigo-deep);
  text-decoration: none;
  transition: background var(--pas-duration-fast) var(--pas-ease),
              color var(--pas-duration-fast) var(--pas-ease);
}
.home-view-all-btn:hover { background: var(--pas-indigo); color: var(--pas-white); }
.home-view-all-btn .bi { transition: transform var(--pas-duration) var(--pas-ease); }
.home-view-all-btn:hover .bi { transform: translateX(3px); }

/* ---- Responsive --------------------------------------------------------- */

@media (max-width: 991.98px) {
  .home-hero-carousel .carousel-caption { text-align: center; place-content: center; }
  .hero-title { max-inline-size: none; margin-inline: auto; }
  .hero-subtitle { margin-inline: auto; }
  .hero-cta { justify-content: center; }
}

@media (max-width: 767.98px) {
  .home-hero-carousel img { min-block-size: 420px; }
  .home-service-card { padding: var(--pas-space-5); }
  .home-section-header { margin-block-end: var(--pas-space-6); }
}

@media (prefers-reduced-motion: reduce) {
  .home-service-card:hover,
  .home-category-card:hover,
  .home-blog-card:hover,
  .home-cta-button:hover { transform: none; }
  .home-category-card:hover .card-img-wrapper img { transform: none; }
}
</file>

<file path="frontend/src/Styles/theme.css">
/* ==========================================================================
   Pass24/7 — Theme layer

   Restyles Bootstrap app-wide. Bootstrap 5.3 is CSS-variable driven, so this
   overrides its own --bs-* API rather than fighting selector specificity.
   That keeps this file low-specificity and means it reaches every page that
   uses Bootstrap classes — which is all of them.

   Load order matters: bootstrap.min.css -> tokens.css -> theme.css
   ========================================================================== */

:root {
  /* ---- Map the brand onto Bootstrap's global tokens ---- */
  --bs-primary: var(--pas-indigo);
  --bs-primary-rgb: 68, 0, 255;
  --bs-secondary: var(--pas-gold);
  --bs-secondary-rgb: 255, 193, 0;
  --bs-success: var(--pas-success);
  --bs-danger: var(--pas-danger);
  --bs-warning: var(--pas-warn);
  --bs-info: var(--pas-info);
  --bs-light: var(--pas-mist);
  --bs-dark: var(--pas-ink);

  --bs-body-font-family: var(--pas-font-body);
  --bs-body-font-size: var(--pas-text-base);
  --bs-body-line-height: var(--pas-leading-normal);
  --bs-body-color: var(--pas-slate);
  --bs-body-bg: var(--pas-surface);
  --bs-emphasis-color: var(--pas-ink);
  --bs-secondary-color: var(--pas-muted);
  --bs-border-color: var(--pas-line);
  --bs-link-color: var(--pas-indigo);
  --bs-link-hover-color: var(--pas-indigo-deep);

  --bs-border-radius: var(--pas-radius);
  --bs-border-radius-sm: var(--pas-radius-sm);
  --bs-border-radius-lg: var(--pas-radius-lg);
  --bs-border-radius-xl: var(--pas-radius-lg);
  --bs-border-radius-pill: var(--pas-radius-pill);

  --bs-box-shadow-sm: var(--pas-shadow-sm);
  --bs-box-shadow: var(--pas-shadow-md);
  --bs-box-shadow-lg: var(--pas-shadow-lg);
}

/* ==========================================================================
   Layout
   ========================================================================== */

.container,
.container-fluid,
.container-lg,
.container-xl {
  --bs-gutter-x: clamp(1rem, 0.5rem + 2vw, 2rem);
}

.container,
.container-lg,
.container-xl {
  max-width: min(100%, var(--pas-container));
}

/* Vertical rhythm helper — consistent section pacing */
.pas-section { padding-block: var(--pas-section-y); }
.pas-section--sunken { background: var(--pas-surface-sunken); }
.pas-section--ink {
  background: var(--pas-ink);
  color: color-mix(in srgb, var(--pas-white) 78%, transparent);
}
.pas-section--ink h1,
.pas-section--ink h2,
.pas-section--ink h3 { color: var(--pas-white); }

/* ==========================================================================
   Buttons
   ========================================================================== */

.btn {
  --bs-btn-padding-y: 0.65rem;
  --bs-btn-padding-x: 1.35rem;
  --bs-btn-font-family: var(--pas-font-display);
  --bs-btn-font-weight: 600;
  --bs-btn-font-size: 0.95rem;
  --bs-btn-border-radius: var(--pas-radius-pill);
  letter-spacing: -0.005em;
  transition:
    transform var(--pas-duration-fast) var(--pas-ease),
    box-shadow var(--pas-duration) var(--pas-ease),
    background-color var(--pas-duration-fast) var(--pas-ease),
    border-color var(--pas-duration-fast) var(--pas-ease),
    color var(--pas-duration-fast) var(--pas-ease);
}

.btn:active { transform: translateY(1px); }
.btn:focus-visible { box-shadow: var(--pas-shadow-focus); outline: none; }

.btn-lg {
  --bs-btn-padding-y: 0.9rem;
  --bs-btn-padding-x: 2rem;
  --bs-btn-font-size: 1.05rem;
}
.btn-sm {
  --bs-btn-padding-y: 0.4rem;
  --bs-btn-padding-x: 1rem;
  --bs-btn-font-size: 0.85rem;
}

.btn-primary {
  --bs-btn-bg: var(--pas-indigo);
  --bs-btn-border-color: var(--pas-indigo);
  --bs-btn-hover-bg: var(--pas-indigo-deep);
  --bs-btn-hover-border-color: var(--pas-indigo-deep);
  --bs-btn-active-bg: var(--pas-indigo-deep);
  --bs-btn-active-border-color: var(--pas-indigo-deep);
  --bs-btn-disabled-bg: color-mix(in srgb, var(--pas-indigo) 45%, var(--pas-white));
  --bs-btn-disabled-border-color: transparent;
  box-shadow: 0 6px 16px rgba(68, 0, 255, 0.22);
}
.btn-primary:hover { box-shadow: 0 10px 24px rgba(68, 0, 255, 0.3); }

/* Gold is the achievement colour — upgrade, unlock, celebrate.
   Dark ink text on gold, because white on #ffc100 fails contrast. */
.btn-warning,
.btn-secondary {
  --bs-btn-color: var(--pas-ink);
  --bs-btn-bg: var(--pas-gold);
  --bs-btn-border-color: var(--pas-gold);
  --bs-btn-hover-color: var(--pas-ink);
  --bs-btn-hover-bg: #ffcd33;
  --bs-btn-hover-border-color: #ffcd33;
  --bs-btn-active-color: var(--pas-ink);
  --bs-btn-active-bg: #e6ae00;
  box-shadow: 0 6px 16px rgba(255, 193, 0, 0.3);
}

.btn-outline-primary {
  --bs-btn-color: var(--pas-indigo-deep);
  --bs-btn-border-color: color-mix(in srgb, var(--pas-indigo) 40%, transparent);
  --bs-btn-hover-bg: var(--pas-indigo);
  --bs-btn-hover-border-color: var(--pas-indigo);
  --bs-btn-hover-color: var(--pas-white);
}

.btn-outline-secondary {
  --bs-btn-color: var(--pas-slate);
  --bs-btn-border-color: var(--pas-line);
  --bs-btn-hover-bg: var(--pas-mist);
  --bs-btn-hover-border-color: var(--pas-muted);
  --bs-btn-hover-color: var(--pas-ink);
}

.btn-light {
  --bs-btn-bg: var(--pas-white);
  --bs-btn-border-color: var(--pas-line);
  --bs-btn-color: var(--pas-ink);
  --bs-btn-hover-bg: var(--pas-mist);
}

.btn-link {
  --bs-btn-color: var(--pas-indigo);
  --bs-btn-font-weight: 600;
  text-underline-offset: 0.2em;
}

/* ==========================================================================
   Cards
   ========================================================================== */

.card {
  --bs-card-border-radius: var(--pas-radius-lg);
  --bs-card-border-color: var(--pas-line);
  --bs-card-bg: var(--pas-surface);
  --bs-card-spacer-y: var(--pas-space-5);
  --bs-card-spacer-x: var(--pas-space-5);
  border-width: 1px;
  transition:
    transform var(--pas-duration) var(--pas-ease),
    box-shadow var(--pas-duration) var(--pas-ease),
    border-color var(--pas-duration) var(--pas-ease);
}

/* Round card imagery without setting overflow:hidden on .card itself —
   that would clip any dropdown, tooltip or popover opened inside a card. */
.card > img:first-child,
.card-img-top {
  border-start-start-radius: calc(var(--pas-radius-lg) - 1px);
  border-start-end-radius: calc(var(--pas-radius-lg) - 1px);
}
.card > img:last-child,
.card-img-bottom {
  border-end-start-radius: calc(var(--pas-radius-lg) - 1px);
  border-end-end-radius: calc(var(--pas-radius-lg) - 1px);
}

.card.shadow-sm { box-shadow: var(--pas-shadow-sm) !important; }
.card.shadow,
.card.shadow-lg { box-shadow: var(--pas-shadow-md) !important; }

/* Lift only where the card is genuinely a target */
a .card:hover,
.card-hover:hover,
.card[role='button']:hover,
button .card:hover {
  transform: translateY(-4px);
  box-shadow: var(--pas-shadow-lg) !important;
  border-color: color-mix(in srgb, var(--pas-indigo) 25%, var(--pas-line));
}

.card-title {
  font-family: var(--pas-font-display);
  font-weight: 700;
  color: var(--pas-ink);
  letter-spacing: var(--pas-tracking-tight);
}

.card-header {
  background: transparent;
  border-bottom-color: var(--pas-line);
  font-family: var(--pas-font-display);
  font-weight: 600;
  color: var(--pas-ink);
  padding-block: var(--pas-space-4);
}

.card-footer { background: transparent; border-top-color: var(--pas-line); }

/* ==========================================================================
   Forms
   ========================================================================== */

.form-control,
.form-select {
  --bs-border-radius: var(--pas-radius-sm);
  padding: 0.7rem 0.95rem;
  border-color: var(--pas-line);
  background-color: var(--pas-surface);
  color: var(--pas-ink);
  font-size: var(--pas-text-base);
  transition:
    border-color var(--pas-duration-fast) var(--pas-ease),
    box-shadow var(--pas-duration-fast) var(--pas-ease);
}

.form-control::placeholder { color: var(--pas-muted); }

.form-control:focus,
.form-select:focus {
  border-color: var(--pas-indigo);
  box-shadow: var(--pas-shadow-focus);
}

.form-control-lg { padding: 0.9rem 1.1rem; font-size: var(--pas-text-lg); }

.form-label {
  font-family: var(--pas-font-display);
  font-weight: 600;
  font-size: var(--pas-text-sm);
  color: var(--pas-ink);
  margin-bottom: var(--pas-space-2);
}

.form-text { color: var(--pas-muted); font-size: var(--pas-text-sm); }

.form-check-input { border-color: var(--pas-muted); }
.form-check-input:checked {
  background-color: var(--pas-indigo);
  border-color: var(--pas-indigo);
}
.form-check-input:focus { box-shadow: var(--pas-shadow-focus); border-color: var(--pas-indigo); }

.input-group-text {
  background: var(--pas-mist);
  border-color: var(--pas-line);
  color: var(--pas-slate);
}

.is-invalid ~ .invalid-feedback,
.invalid-feedback { color: var(--pas-danger); font-size: var(--pas-text-sm); }

/* ==========================================================================
   Badges
   ========================================================================== */

.badge {
  --bs-badge-font-weight: 600;
  --bs-badge-padding-x: 0.7em;
  --bs-badge-padding-y: 0.45em;
  font-family: var(--pas-font-display);
  letter-spacing: 0.01em;
  border-radius: var(--pas-radius-pill);
}

.badge.bg-primary { background: color-mix(in srgb, var(--pas-indigo) 12%, var(--pas-white)) !important; color: var(--pas-indigo-deep); }
.badge.bg-success { background: var(--pas-success-soft) !important; color: var(--pas-success); }
.badge.bg-danger  { background: var(--pas-danger-soft) !important;  color: var(--pas-danger); }
.badge.bg-warning { background: var(--pas-warn-soft) !important;    color: var(--pas-warn); }
.badge.bg-info    { background: var(--pas-info-soft) !important;    color: var(--pas-info); }
.badge.bg-secondary { background: var(--pas-mist) !important; color: var(--pas-slate); }

/* ==========================================================================
   Alerts
   ========================================================================== */

.alert {
  --bs-alert-border-radius: var(--pas-radius);
  border: 1px solid transparent;
  border-left-width: 3px;
  padding: var(--pas-space-4) var(--pas-space-5);
}
.alert-success { background: var(--pas-success-soft); border-left-color: var(--pas-success); color: #0a6b3d; }
.alert-danger  { background: var(--pas-danger-soft);  border-left-color: var(--pas-danger);  color: #96201f; }
.alert-warning { background: var(--pas-warn-soft);    border-left-color: var(--pas-gold);    color: #7a5c00; }
.alert-info    { background: var(--pas-info-soft);    border-left-color: var(--pas-info);    color: #0a5c7a; }

/* ==========================================================================
   Navbar
   ========================================================================== */

/* Navbar.jsx carries its own inline <style> block with scroll-dependent
   background classes (.navbar-dark-bg / .navbar-scrolled). Those own the
   background and are left authoritative — this only supplies the glass
   treatment when neither is active, plus shared typography. */
.navbar:not(.navbar-dark-bg):not(.navbar-scrolled) {
  background: color-mix(in srgb, var(--pas-white) 88%, transparent);
  backdrop-filter: saturate(180%) blur(14px);
  -webkit-backdrop-filter: saturate(180%) blur(14px);
  border-bottom: 1px solid var(--pas-line);
}

.navbar { --bs-navbar-padding-y: var(--pas-space-3); }

.navbar-brand {
  font-family: var(--pas-font-display);
  font-weight: 800;
  letter-spacing: var(--pas-tracking-tight);
  color: var(--pas-ink);
}

.navbar .nav-link {
  font-family: var(--pas-font-display);
  font-weight: 500;
  font-size: 0.95rem;
  color: var(--pas-slate);
  padding-inline: var(--pas-space-3);
  border-radius: var(--pas-radius-sm);
  transition: color var(--pas-duration-fast) var(--pas-ease),
              background-color var(--pas-duration-fast) var(--pas-ease);
}
.navbar .nav-link:hover { color: var(--pas-indigo); background: var(--pas-mist); }
.navbar .nav-link.active { color: var(--pas-indigo-deep); font-weight: 600; }

.dropdown-menu {
  --bs-dropdown-border-color: var(--pas-line);
  --bs-dropdown-border-radius: var(--pas-radius);
  --bs-dropdown-link-active-bg: var(--pas-indigo);
  box-shadow: var(--pas-shadow-lg);
  padding: var(--pas-space-2);
}
.dropdown-item {
  border-radius: var(--pas-radius-sm);
  font-size: 0.95rem;
  padding: 0.55rem 0.75rem;
}
.dropdown-item:hover { background: var(--pas-mist); color: var(--pas-indigo-deep); }

/* ==========================================================================
   Tabs & pills
   ========================================================================== */

.nav-tabs {
  border-bottom-color: var(--pas-line);
  gap: var(--pas-space-1);
}
.nav-tabs .nav-link {
  border: 0;
  border-bottom: 2px solid transparent;
  border-radius: 0;
  font-family: var(--pas-font-display);
  font-weight: 600;
  color: var(--pas-muted);
  padding: var(--pas-space-3) var(--pas-space-4);
}
.nav-tabs .nav-link:hover { color: var(--pas-ink); border-bottom-color: var(--pas-line); }
.nav-tabs .nav-link.active {
  color: var(--pas-indigo-deep);
  background: transparent;
  border-bottom-color: var(--pas-indigo);
}

.nav-pills .nav-link {
  border-radius: var(--pas-radius-pill);
  font-family: var(--pas-font-display);
  font-weight: 600;
  color: var(--pas-slate);
}
.nav-pills .nav-link.active { background: var(--pas-indigo); }

/* ==========================================================================
   Tables
   ========================================================================== */

.table {
  --bs-table-border-color: var(--pas-line);
  --bs-table-hover-bg: var(--pas-mist);
  color: var(--pas-slate);
  vertical-align: middle;
}
.table > thead {
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-xs);
  text-transform: uppercase;
  letter-spacing: var(--pas-tracking-wide);
  color: var(--pas-muted);
}
.table > thead th { border-bottom: 1px solid var(--pas-line); padding-block: var(--pas-space-3); font-weight: 600; }
.table > tbody td { padding-block: var(--pas-space-4); }
/* Numeric columns align and use tabular figures */
.table td.num, .table th.num { text-align: right; font-family: var(--pas-font-data); font-variant-numeric: tabular-nums; }

/* ==========================================================================
   Progress
   ========================================================================== */

.progress {
  --bs-progress-bg: var(--pas-line);
  --bs-progress-border-radius: var(--pas-radius-pill);
  height: 8px;
  overflow: hidden;
}
.progress-bar {
  background: linear-gradient(90deg, var(--pas-indigo), var(--pas-indigo-lift));
  transition: width var(--pas-duration-slow) var(--pas-ease);
}

/* ==========================================================================
   Modal, pagination, misc
   ========================================================================== */

.modal-content {
  border: 0;
  border-radius: var(--pas-radius-lg);
  box-shadow: var(--pas-shadow-lg);
}
.modal-header, .modal-footer { border-color: var(--pas-line); }
.modal-title { font-family: var(--pas-font-display); font-weight: 700; color: var(--pas-ink); }

.page-link {
  color: var(--pas-slate);
  border-color: var(--pas-line);
  font-family: var(--pas-font-display);
  font-weight: 600;
}
.page-item.active .page-link { background: var(--pas-indigo); border-color: var(--pas-indigo); }

.spinner-border { color: var(--pas-indigo); }

.list-group-item { border-color: var(--pas-line); padding: var(--pas-space-4); }

.text-muted { color: var(--pas-muted) !important; }
.text-primary { color: var(--pas-indigo) !important; }
.bg-light { background-color: var(--pas-mist) !important; }
.border { border-color: var(--pas-line) !important; }

/* ==========================================================================
   Signature: the answer-sheet option marker
   Drawn from the product's own world — every question in this app is
   multiple choice. Used as an eyebrow marker and hero anchor, sparingly.
   ========================================================================== */

.pas-marker {
  display: inline-grid;
  place-items: center;
  inline-size: 2.25rem;
  block-size: 2.25rem;
  border-radius: 50%;
  border: 1.5px solid color-mix(in srgb, var(--pas-indigo) 35%, transparent);
  font-family: var(--pas-font-data);
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--pas-indigo-deep);
  background: color-mix(in srgb, var(--pas-indigo) 7%, transparent);
  flex: none;
}
.pas-marker--filled {
  background: var(--pas-indigo);
  border-color: var(--pas-indigo);
  color: var(--pas-white);
}
.pas-marker--gold {
  background: var(--pas-gold);
  border-color: var(--pas-gold);
  color: var(--pas-ink);
}
.pas-marker--sm { inline-size: 1.75rem; block-size: 1.75rem; font-size: 0.8rem; }

/* Eyebrow label — pairs with the marker above section titles */
.pas-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: var(--pas-space-2);
  font-family: var(--pas-font-display);
  font-size: var(--pas-text-xs);
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: var(--pas-tracking-wide);
  color: var(--pas-indigo-deep);
  margin-bottom: var(--pas-space-3);
}

/* ==========================================================================
   Motion
   ========================================================================== */

@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  .card:hover,
  a .card:hover,
  .card-hover:hover { transform: none; }
}
</file>

<file path="frontend/src/Styles/tokens.css">
/* ==========================================================================
   Pass24/7 — Design tokens
   Single source of truth for colour, type, space, elevation and motion.

   The palette is derived from the identity already in the product
   (#4400ff appears 161 times, #ffc100 66 times). It is refined, not
   replaced: neutrals are given a violet cast so they harmonise with the
   indigo instead of fighting it, and the deep tone is darkened for
   contrast on light backgrounds.
   ========================================================================== */

:root {
  /* ---- Brand ---- */
  --pas-indigo: #4400ff;
  --pas-indigo-deep: #2b00a3;   /* headings, hover, text-on-light */
  --pas-indigo-lift: #6a4cff;   /* gradients, decorative lift */
  --pas-gold: #ffc100;          /* achievement, highlight, accent */
  --pas-gold-deep: #d99f00;     /* gold text on light — meets contrast */

  /* ---- Neutrals (violet-cast, tuned to the brand) ---- */
  --pas-ink: #12101a;           /* primary text / darkest surface */
  --pas-graphite: #2c2839;      /* secondary dark surface */
  --pas-slate: #5b5670;         /* body copy */
  --pas-muted: #8b8699;         /* captions, meta */
  --pas-line: #e4e1ee;          /* hairlines, borders */
  --pas-mist: #f6f5fb;          /* page tint */
  --pas-white: #ffffff;

  /* ---- Semantic status ---- */
  --pas-success: #0f9d58;
  --pas-success-soft: #e6f6ee;
  --pas-danger: #d93838;
  --pas-danger-soft: #fdeaea;
  --pas-warn: #b98900;
  --pas-warn-soft: #fff6e0;
  --pas-info: #0b7fa8;
  --pas-info-soft: #e5f4fa;

  /* ---- Surfaces ---- */
  --pas-surface: var(--pas-white);
  --pas-surface-sunken: var(--pas-mist);
  --pas-surface-invert: var(--pas-ink);

  /* ---- Type ---- */
  --pas-font-display: 'Sora', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --pas-font-body: 'Source Sans 3', system-ui, -apple-system, 'Segoe UI', sans-serif;
  --pas-font-data: 'IBM Plex Mono', ui-monospace, 'SF Mono', Consolas, monospace;

  /* Fluid type scale — clamp keeps it responsive without breakpoint jumps */
  --pas-text-xs: 0.78rem;
  --pas-text-sm: 0.875rem;
  --pas-text-base: 1rem;
  --pas-text-lg: 1.125rem;
  --pas-text-xl: clamp(1.25rem, 1.1rem + 0.6vw, 1.5rem);
  --pas-text-2xl: clamp(1.5rem, 1.25rem + 1.1vw, 2rem);
  --pas-text-3xl: clamp(1.875rem, 1.4rem + 2vw, 2.75rem);
  --pas-text-4xl: clamp(2.25rem, 1.5rem + 3.4vw, 4rem);

  --pas-leading-tight: 1.12;
  --pas-leading-snug: 1.3;
  --pas-leading-normal: 1.6;
  --pas-leading-relaxed: 1.75;  /* long-form: questions, explanations */

  --pas-tracking-tight: -0.022em;
  --pas-tracking-normal: 0;
  --pas-tracking-wide: 0.08em;   /* eyebrows, small caps */

  /* ---- Space (4px base) ---- */
  --pas-space-1: 0.25rem;
  --pas-space-2: 0.5rem;
  --pas-space-3: 0.75rem;
  --pas-space-4: 1rem;
  --pas-space-5: 1.5rem;
  --pas-space-6: 2rem;
  --pas-space-7: 3rem;
  --pas-space-8: 4rem;
  --pas-space-9: 6rem;

  /* Section rhythm — one variable so vertical pacing stays consistent */
  --pas-section-y: clamp(3rem, 2rem + 5vw, 6rem);

  /* ---- Radius ---- */
  --pas-radius-sm: 8px;
  --pas-radius: 14px;
  --pas-radius-lg: 22px;
  --pas-radius-pill: 999px;

  /* ---- Elevation ----
     A real scale rather than scattered one-off shadows. Tinted with the
     brand indigo so shadows read as part of the palette, not grey smudges. */
  --pas-shadow-xs: 0 1px 2px rgba(18, 16, 26, 0.06);
  --pas-shadow-sm: 0 2px 8px rgba(43, 0, 163, 0.06), 0 1px 2px rgba(18, 16, 26, 0.04);
  --pas-shadow-md: 0 8px 24px rgba(43, 0, 163, 0.09), 0 2px 6px rgba(18, 16, 26, 0.04);
  --pas-shadow-lg: 0 18px 44px rgba(43, 0, 163, 0.13), 0 4px 12px rgba(18, 16, 26, 0.05);
  --pas-shadow-focus: 0 0 0 3px rgba(68, 0, 255, 0.28);

  /* ---- Motion ---- */
  --pas-ease: cubic-bezier(0.32, 0.72, 0, 1);
  --pas-duration-fast: 140ms;
  --pas-duration: 240ms;
  --pas-duration-slow: 420ms;

  /* ---- Layout ---- */
  --pas-container: 1220px;
  --pas-container-narrow: 780px;  /* reading measure for long-form content */
}

/* ==========================================================================
   Legacy compatibility layer

   The stylesheet that previously defined --primary/--secondary/--white etc.
   was replaced by this token system. Roughly 300 references to those names
   remain in component-level inline <style> blocks across 10+ files
   (Home, Exams, Blog, Contact, About, Careers, CVBuildUp, skills,
   InterviewLevels...).

   Aliasing them onto the new tokens does two things: it keeps those
   components working, and it means they now inherit the refined palette
   automatically instead of holding stale hard-coded values. Migrate call
   sites to the --pas-* names over time; then this block can be deleted.
   ========================================================================== */

:root {
  --primary: var(--pas-indigo);
  --primary-dark: var(--pas-indigo-deep);
  --primary-light: var(--pas-indigo-lift);
  --secondary: var(--pas-gold);
  --secondary-dark: var(--pas-gold-deep);
  --secondary-light: #ffd700;
  --dark: var(--pas-ink);
  --dark-bg: var(--pas-ink);
  --gray: var(--pas-slate);
  --light: var(--pas-mist);
  --white: var(--pas-white);

  --gradient-primary: linear-gradient(135deg, var(--pas-indigo) 0%, var(--pas-indigo-lift) 100%);
  --gradient-secondary: linear-gradient(135deg, var(--pas-gold) 0%, #ffd700 100%);
  --gradient-hero: linear-gradient(135deg, rgba(68, 0, 255, 0.30) 0%, rgba(255, 193, 0, 0.18) 100%);

  --shadow-sm: var(--pas-shadow-sm);
  --shadow-md: var(--pas-shadow-md);
  --shadow-lg: var(--pas-shadow-lg);
  --shadow-hover: var(--pas-shadow-lg);

  --transition: all var(--pas-duration) var(--pas-ease);
  --border-radius: var(--pas-radius);
  --border-radius-sm: var(--pas-radius-sm);
  --border-radius-lg: var(--pas-radius-lg);
}

/* Honour the OS setting. Motion is decoration here, never information. */
@media (prefers-reduced-motion: reduce) {
  :root {
    --pas-duration-fast: 1ms;
    --pas-duration: 1ms;
    --pas-duration-slow: 1ms;
  }
}
</file>

