"""
Diagnose SMTP using the project's real settings.

    python3 manage.py shell < email_test.py

Edit TO below first.
"""
TO = "petlegendary2019@gmail.com"          # <-- CHANGE THIS

from django.conf import settings
from django.core.mail import EmailMessage

pw = settings.EMAIL_HOST_PASSWORD or ""
print("=" * 60)
print("CONFIG DJANGO ACTUALLY LOADED")
print("=" * 60)
print(f"  BACKEND      : {settings.EMAIL_BACKEND}")
print(f"  HOST         : {getattr(settings, 'EMAIL_HOST', '<unset>')}")
print(f"  PORT         : {getattr(settings, 'EMAIL_PORT', '<unset>')}")
print(f"  USE_SSL      : {getattr(settings, 'EMAIL_USE_SSL', '<unset>')}")
print(f"  USE_TLS      : {getattr(settings, 'EMAIL_USE_TLS', '<unset>')}")
print(f"  HOST_USER    : {getattr(settings, 'EMAIL_HOST_USER', '<unset>')}")
print(f"  FROM         : {getattr(settings, 'DEFAULT_FROM_EMAIL', '<unset>')}")
print(f"  PASSWORD     : {len(pw)} chars, starts {pw[:2]!r}" if pw else "  PASSWORD     : *** EMPTY ***")
print()

if "console" in settings.EMAIL_BACKEND:
    print("Console backend is active — nothing will be sent over SMTP.")
    raise SystemExit

if not pw:
    print("EMAIL_HOST_PASSWORD is empty. Check .env for a duplicate key:")
    print("    grep -n EMAIL_HOST_PASSWORD .env")
    print("django-environ uses the FIRST occurrence.")
    raise SystemExit

print(f"Sending a test message to {TO} ...")
try:
    msg = EmailMessage("PAS SMTP test", "If you received this, SMTP works.", None, [TO])
    msg.fail_silently = False
    sent = msg.send()
    print(f"\nOK — send() returned {sent}. Check the inbox AND the spam folder.")
except Exception as exc:
    print(f"\nFAILED: {type(exc).__name__}: {exc}\n")
    text = str(exc).lower()
    if "authentication" in text or "535" in text or "534" in text:
        print("-> Credentials rejected. Wrong password, or the mailbox")
        print("   noreply@pass247.net does not exist on mail.pass247.net.")
    elif "timed out" in text or "timeout" in text:
        print("-> No response in 10s. Host or port wrong, or the port is")
        print("   firewalled. Try: nc -vz mail.pass247.net 465")
    elif "ssl" in text or "wrong_version" in text or "record layer" in text:
        print("-> TLS/SSL mismatch. Port 465 needs USE_SSL=True/USE_TLS=False.")
        print("   If the server actually wants STARTTLS, use port 587 with")
        print("   USE_TLS=True and USE_SSL=False.")
    elif "name or service not known" in text or "getaddrinfo" in text:
        print("-> Hostname does not resolve. Check: nslookup mail.pass247.net")
    elif "sender" in text or "relay" in text or "550" in text:
        print("-> Server refused the sender/relay. DEFAULT_FROM_EMAIL must")
        print("   usually match the authenticated mailbox exactly.")
