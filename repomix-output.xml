                  className="lead mb-4"
                  initial={{ opacity: 0 }}
                  animate={{ opacity: 1 }}
                  transition={{ delay: 0.4 }}
                >
                  Your payment was cancelled. No charges were made to your account.
                </motion.p>
                
                {/* Information Box */}
                <motion.div 
                  className="bg-light p-4 rounded-3 mb-4 text-start"
