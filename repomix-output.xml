                  Start Quiz <i className="bi bi-arrow-right ms-2"></i>
                </button>
              </div>
            </motion.div>
          </div>
        </div>
      </div>
    );
  }

  if (quizCompleted && results) {
    return (
      <div className="quiz-results container py-5" style={{ minHeight: '70vh' }}>
