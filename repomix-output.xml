# Run with:  python3 manage.py shell < check_routes.py
from django.urls import get_resolver

resolver = get_resolver()
found = []

def walk(patterns, prefix=''):
    for p in patterns:
        if hasattr(p, 'url_patterns'):
            walk(p.url_patterns, prefix + str(p.pattern))
        else:
            found.append(prefix + str(p.pattern))

walk(resolver.url_patterns)

auth = sorted(r for r in found if 'auth' in r)
print(f"total routes registered: {len(found)}\n")
print("routes under /api/auth/:")
if auth:
    for r in auth:
        print("   /" + r)
else:
    print("   *** NONE — users.urls_api is not included in paswebsite/urls.py ***")

print("\nregister route present:",
      any('auth/register' in r for r in found))
print("verify-otp route present:",
      any('verify-otp' in r for r in found))
