          background: rgba(0, 0, 0, 0.95); /* Black background */
          border: 1px solid rgba(0, 123, 255, 0.5); /* Subtle blue border */
          border-radius: 10px; /* Rounded corners */
          box-shadow: 0px 10px 25px rgba(0, 123, 255, 0.3); /* Soft blue shadow */
          overflow: hidden;
          padding: 10px 0;
          transform: translateY(10px);
          opacity: 0;
          visibility: hidden;
          transition: all 0.3s ease-in-out;
      }
  
      /* SHOW DROPDOWN ON HOVER */
      .nav-item.dropdown:hover .dropdown-menu {
          transform: translateY(0);
          opacity: 1;
          visibility: visible;
      }
  
      /* DROPDOWN ITEM STYLING */
      .dropdown-item {
          color: #f0f5fb !important; /* Blue text */
          font-weight: 500;
          padding: 12px 20px;
          transition: all 0.3s ease-in-out;
          border-radius: 6px;
          position: relative;
          overflow: hidden;
      }
  
      /* HOVER EFFECT FOR DROPDOWN ITEMS */
      .dropdown-item:hover {
          background: #000 !important; /* Black hover background */
          color: #ffc100 !important; /* Gold text */
          padding-left: 25px; /* Sliding effect */
      }
  
      /* UNDERLINE EFFECT */
      .dropdown-item::before {
          content: "";
          position: absolute;
          bottom: 5px;
          left: 20px;
          width: 0;
          height: 2px;
          background: #ffc100; /* Gold underline */
          transition: width 0.3s ease-in-out;
      }
  
      .dropdown-item:hover::before {
          width: 60%;
      }
  
      /* SUBSCRIBE BUTTON IN DROPDOWN */
      .dropdown-item.btn-warning {
          text-align: center;
          font-weight: bold;
          border-radius: 30px;
          padding: 12px 15px;
          transition: all 0.3s ease-in-out;
          background: #ffc100; /* Gold button */
          color: #000 !important; /* Black text */
      }
  
      /* HOVER EFFECT FOR SUBSCRIBE BUTTON */
      .dropdown-item.btn-warning:hover {
