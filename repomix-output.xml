{% endblock %}

{% block content %}
<div id="content-main" class="upload-container">
    <h1>📤 Bulk Upload Questions</h1>
    
    <div style="background: #f8f9fa; padding: 20px; border-radius: 8px; margin-bottom: 20px;">
        <h3 style="color: #1a1a1a;">Instructions:</h3>
        <ol style="color: #333333;">
            <li>Download the template using the button below</li>
            <li>Fill in your questions following the format</li>
            <li>For OBJECTIVE questions, fill options A-E and correct answer</li>
            <li>For THEORY questions, fill model answer and marking guide</li>
            <li><strong>Optional:</strong> add <code>diagram_url</code> (image URL / file path) for questions with a figure</li>
            <li><strong>Optional:</strong> add <code>essay_paragraph</code> (or <code>comprehension_text</code>) for passage/essay questions</li>
            <li>Subject and Exam Category must already exist in the system</li>
            <li>Upload the completed Excel or CSV file (blank optional cells are ignored)</li>
        </ol>
        <a href="{% url 'admin:exams_question_download_template' %}" 
           class="button" style="background: #28a745; color: white;">
            📥 Download Excel Template
        </a>
    </div>
    
    <form method="post" enctype="multipart/form-data" 
          style="background: white; padding: 20px; border-radius: 8px;">
        {% csrf_token %}
        
        <div style="margin-bottom: 20px;">
            <label for="excel_file" style="color: #1a1a1a;">
                <strong>Select Excel or CSV File (.xlsx, .xls or .csv):</strong>
            </label>
            <input type="file" name="excel_file" id="excel_file" 
                   accept=".xlsx,.xls,.csv" required 
                   style="display: block; margin-top: 10px;">
        </div>
        
        <div style="margin-bottom: 20px;">
            <label style="color: #333333;">
                <input type="checkbox" name="create_question_banks" checked>
                <strong>Automatically create question banks from uploaded questions</strong>
            </label>
        </div>
        
        <div style="margin-top: 20px;">
            <button type="submit" class="button" 
                    style="background: #007bff; color: white; padding: 10px 20px; font-size: 16px;">
                🚀 Upload Questions
            </button>
            <a href="{% url 'admin:exams_question_changelist' %}" 
               class="button" style="background: #6c757d; color: white; padding: 10px 20px;">
                Cancel
            </a>
        </div>
    </form>
    
    {% if result %}
    <div style="margin-top: 30px; background: white; padding: 20px; border-radius: 8px;">
        <h2 style="color: #1a1a1a;">📊 Upload Results</h2>
        
        <div style="display: flex; gap: 20px; margin-bottom: 20px;">
            <div style="flex: 1; background: #d4edda; padding: 15px; border-radius: 8px;" class="success-box">
                <h3>✅ Success</h3>
                <p style="font-size: 24px; font-weight: bold;">{{ result.success_count }}</p>
            </div>
            <div style="flex: 1; background: #f8d7da; padding: 15px; border-radius: 8px;" class="error-box">
                <h3>❌ Errors</h3>
                <p style="font-size: 24px; font-weight: bold;">{{ result.error_count }}</p>
            </div>
        </div>
        
        {% if result.question_banks_created %}
        <h3 style="color: #1a1a1a;">📚 Question Banks Created</h3>
        <ul style="color: #333333;">
            {% for bank in result.question_banks_created %}
            <li>{{ bank.name }} ({{ bank.question_count }} questions)</li>
            {% endfor %}
        </ul>
        {% endif %}
        
        {% if result.errors %}
        <h3 style="color: #1a1a1a;">Error Details:</h3>
        <table style="width: 100%; border-collapse: collapse;" class="result-table">
            <thead>
                <tr style="background: #f8f9fa;">
                    <th style="padding: 8px; border: 1px solid #ddd; color: #1a1a1a;">Row</th>
                    <th style="padding: 8px; border: 1px solid #ddd; color: #1a1a1a;">Error</th>
                </tr>
            </thead>
            <tbody>
                {% for error in result.errors %}
                <tr>
                    <td style="padding: 8px; border: 1px solid #ddd; color: #333333;">{{ error.row }}</td>
                    <td style="padding: 8px; border: 1px solid #ddd; color: #dc3545;">
                        {{ error.error }}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        {% endif %}
    </div>
    {% endif %}
</div>
{% endblock %}
