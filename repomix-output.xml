                          onClick={() => {
                            setShowSupport(true);
                            setSupportMessage(`I cancelled because: ${reason}`);
                          }}
                        >
                          {reason}
                        </button>
                      ))}
                    </div>
                  </motion.div>
                )}
                
                {/* Action Buttons */}
                <motion.div 
                  className="d-flex gap-3 justify-content-center flex-wrap"
