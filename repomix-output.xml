              <div className="card-body p-5">
                <div className="text-center mb-4">
                  <div className="result-icon mb-3">
                    {results.percent >= 70 ? (
                      <i className="bi bi-trophy-fill" style={{ fontSize: '4rem', color: '#ffc100' }}></i>
